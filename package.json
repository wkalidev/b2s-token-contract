{
  "name": "@wkalidev/b2s-contracts",
  "version": "1.3.0",
  "description": "$B2S Token — Smart Contracts & TypeScript SDK for Base2Stacks DeFi on Stacks mainnet",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js",
      "require": "./dist/contracts.cjs"
    },
    "./helpers": {
      "types": "./dist/helpers.d.ts",
      "import": "./dist/helpers.js",
      "require": "./dist/helpers.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/contracts.ts src/helpers.ts src/types.ts --format cjs,esm --dts --out-dir dist --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "stacks",
    "clarity",
    "defi",
    "b2s",
    "base2stacks",
    "sip010",
    "smart-contracts",
    "bitcoin",
    "web3",
    "typescript",
    "sdk"
  ],
  "author": "wkalidev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wkalidev/base2stacks-tracker.git"
  },
  "homepage": "https://base2stacks-tracker.vercel.app",
  "bugs": {
    "url": "https://github.com/wkalidev/base2stacks-tracker/issues"
  },
  "dependencies": {
    "@stacks/transactions": "^7.3.1",
    "@stacks/network": "^7.3.1"
  },
  "devDependencies": {
    "@hirosystems/clarinet-sdk": "^3.8.1",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "@stacks/transactions": ">=6.0.0"
  }
}
